{
  "rules": {
    ".read": false,
    ".write": false,
    "adminNews": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
        ".validate": "!newData.exists() || (newData.hasChildren(['id','titulo','conteudo','status']) && newData.child('id').isString() && newData.child('id').val() == $slug && newData.child('titulo').isString() && newData.child('titulo').val().length > 2 && newData.child('titulo').val().length <= 180 && newData.child('conteudo').isString() && newData.child('status').isString() && (newData.child('status').val() == 'published' || newData.child('status').val() == 'draft'))"
      }
    },
    "adminDrafts": {
      ".read": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
      "$slug": {
        ".write": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
        ".validate": "!newData.exists() || (newData.hasChildren(['id','titulo','conteudo','status']) && newData.child('id').isString() && newData.child('id').val() == $slug && newData.child('titulo').isString() && newData.child('titulo').val().length > 2 && newData.child('titulo').val().length <= 180 && newData.child('conteudo').isString() && newData.child('status').val() == 'draft')"
      }
    },
    "homeBroadcastVideos": {
      ".read": true,
      "$key": {
        ".write": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
        ".validate": "!newData.exists() || (newData.hasChildren(['key','url','videoId','enabled']) && newData.child('key').isString() && newData.child('key').val() == $key && newData.child('url').isString() && newData.child('url').val().length >= 8 && newData.child('url').val().length <= 500 && newData.child('videoId').isString() && newData.child('videoId').val().length >= 6 && newData.child('videoId').val().length <= 20 && newData.child('enabled').isBoolean())"
      }
    },
    "adminLiveChannels": {
      ".read": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
      "$id": {
        ".write": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
        ".validate": "!newData.exists() || (newData.hasChildren(['id','name','url']) && newData.child('id').isString() && newData.child('id').val() == $id && newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 120 && newData.child('url').isString() && newData.child('url').val().length >= 8 && newData.child('url').val().length <= 500)"
      }
    },
    "adminLives": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
        ".validate": "!newData.exists() || (newData.hasChildren(['id','torneio','canal','inicio','duracaoMinutos']) && newData.child('id').isString() && newData.child('id').val() == $id && newData.child('torneio').isString() && newData.child('torneio').val().length >= 2 && newData.child('torneio').val().length <= 120 && newData.child('canal').isString() && newData.child('canal').val().length >= 1 && newData.child('canal').val().length <= 120 && newData.child('inicio').isString() && newData.child('inicio').val().length >= 10 && newData.child('inicio').val().length <= 32 && newData.child('duracaoMinutos').isNumber() && newData.child('duracaoMinutos').val() > 0 && newData.child('duracaoMinutos').val() <= 4320 && (!newData.child('tipo').exists() || (newData.child('tipo').isString() && (newData.child('tipo').val() == 'mobile' || newData.child('tipo').val() == 'emulador' || newData.child('tipo').val() == 'misto'))) && (!newData.child('regiao').exists() || (newData.child('regiao').isString() && (newData.child('regiao').val() == 'brasil' || newData.child('regiao').val() == 'internacional'))) && (!newData.child('nivel').exists() || (newData.child('nivel').isString() && (newData.child('nivel').val() == 'oficial' || newData.child('nivel').val() == 'amador'))) && (!newData.child('linkMode').exists() || (newData.child('linkMode').isString() && (newData.child('linkMode').val() == 'always' || newData.child('linkMode').val() == 'schedule')))) && (!newData.child('embedEnabled').exists() || newData.child('embedEnabled').isBoolean()) && (!newData.child('embedUrl').exists() || (newData.child('embedUrl').isString() && newData.child('embedUrl').val().length <= 500)) && (!newData.child('embedVideoId').exists() || (newData.child('embedVideoId').isString() && newData.child('embedVideoId').val().length >= 6 && newData.child('embedVideoId').val().length <= 20))"
      }
    },
    "adminTitles": {
      ".read": true,
      "$id": {
        ".write": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
        ".validate": "!newData.exists() || (newData.hasChildren(['id','name','date','winner','runnerUp','third','mvpRanking']) && newData.child('id').isString() && newData.child('id').val() == $id && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 160 && newData.child('date').isString() && newData.child('date').val().length == 10 && newData.child('winner').isString() && newData.child('winner').val().length >= 1 && newData.child('winner').val().length <= 100 && newData.child('runnerUp').isString() && newData.child('runnerUp').val().length >= 1 && newData.child('runnerUp').val().length <= 100 && newData.child('third').isString() && newData.child('third').val().length >= 1 && newData.child('third').val().length <= 100 && newData.child('mvpRanking').exists())"
      }
    },
    "newsMetrics": {
      ".read": true,
      "$slug": {
        "views": {
          ".write": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() == 1) || (data.isNumber() && newData.val() == data.val() + 1))"
        },
        "likes": {
          ".write": "newData.isNumber() && newData.val() >= 0 && ((!data.exists() && newData.val() == 1) || (data.isNumber() && (newData.val() == data.val() + 1 || newData.val() == data.val() - 1)))"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "newsComments": {
      ".read": true,
      "$slug": {
        ".indexOn": [
          "createdAt"
        ],
        "$comment": {
          ".write": "(auth != null && auth.token.email == 'admin@centralfreefire.com.br') || (!data.exists() && newData.exists() && newData.hasChildren(['name','text','createdAt','clientId']) && newData.child('name').isString() && newData.child('name').val().length >= 2 && newData.child('name').val().length <= 36 && newData.child('text').isString() && newData.child('text').val().length >= 2 && newData.child('text').val().length <= 600 && newData.child('createdAt').isNumber() && newData.child('createdAt').val() <= now + 10000 && newData.child('createdAt').val() >= now - 120000 && newData.child('clientId').isString() && newData.child('clientId').val().length >= 3 && newData.child('clientId').val().length <= 80)",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 36"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 600"
          },
          "createdAt": {
            ".validate": "newData.isNumber() && newData.val() <= now + 10000 && newData.val() >= now - 120000"
          },
          "clientId": {
            ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 80"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "siteAnalytics": {
      ".read": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
      "pages": {
        "$page": {
          ".write": "newData.hasChildren(['path','title','views','lastViewedAt']) && newData.child('path').isString() && newData.child('path').val().length <= 300 && newData.child('title').isString() && newData.child('title').val().length <= 160 && newData.child('views').isNumber() && ((!data.exists() && newData.child('views').val() == 1) || (data.child('views').isNumber() && newData.child('views').val() == data.child('views').val() + 1)) && (!data.exists() || newData.child('path').val() == data.child('path').val()) && newData.child('lastViewedAt').isNumber() && newData.child('lastViewedAt').val() <= now && newData.child('lastViewedAt').val() >= now - 60000",
          "path": {
            ".validate": "newData.isString() && newData.val().length <= 300"
          },
          "title": {
            ".validate": "newData.isString() && newData.val().length <= 160"
          },
          "views": {
            ".validate": "newData.isNumber() && newData.val() >= 1"
          },
          "lastViewedAt": {
            ".validate": "newData.isNumber() && newData.val() <= now && newData.val() >= now - 60000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "mercadoUserVotes": {
      ".read": true,
      "$item": {
        "$client": {
          ".write": true,
          ".validate": "!newData.exists() || newData.val() == 'up' || newData.val() == 'down'"
        }
      }
    },
    "dayUserVotes": {
      ".read": true,
      "$match": {
        "$client": {
          ".write": true,
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 80)"
        }
      }
    },
    "adminHiddenNews": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
        ".validate": "!newData.exists() || newData.val() == true"
      }
    },
    "adminCodiguinhos": {
      ".read": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
      ".write": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'"
    },
    "adminTasks": {
      ".read": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'",
      ".write": "auth != null && auth.token.email == 'admin@centralfreefire.com.br'"
    },
